# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only Supabase Edge Function secret (configure in Supabase, not Vite)
GEMINI_API_KEY=your-server-only-gemini-api-key
PAGESPEED_API_KEY=your-server-only-pagespeed-api-key

# Optional server-side Supabase key fallbacks for Edge Functions. Prefer the
# project's SUPABASE_*_KEYS JSON dictionaries when those are already configured.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_ANON_KEY=your-server-only-anon-key

# Comma-separated browser origins allowed by Edge Functions
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
